{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=StoreDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "CachedAggregate": {
    "Basket": {
      "AbsoluteExpirationDays": 30,
      "SlidingExpirationDays": 7,
      "LocalCacheExpirationMinutes": 5,
      "SlidingRefreshThresholdMinutes": 10
    }
  }
}
